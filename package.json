{
  "name": "linux-troubleshooting-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Diagnose Linux failures with real strace.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
